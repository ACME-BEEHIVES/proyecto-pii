# ============================================
# UpShield Edge Agent — Configuración
# ============================================
# Copie este archivo como ".env" y complete los valores.

# === Base de Datos ===
# Conexión a MySQL 8.0 (ajustar usuario, contraseña y host según su entorno)
DATABASE_URL=mysql+mysqlconnector://root:@host.docker.internal:3306/pii_discovery

# === Cifrado PII ===
# Llave AES-256 para cifrar datos sensibles. Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANTE: NO comparta esta llave. Si se pierde, los datos sensibles cifrados serán irrecuperables.
PII_ENCRYPTION_KEY=

# === Servicios Docker (no modificar si usa docker-compose) ===
TIKA_URL=http://tika:9998/tika
PRESIDIO_URL=http://presidio-analyzer:3000/analyze
PRESIDIO_HEALTH_URL=http://presidio-analyzer:3000/health

# === Conexión a UpShield Central ===
# Credenciales proporcionadas por UpShield al registrar su organización.
UPSHIELD_API_URL=https://api.upshield.cl
UPSHIELD_API_KEY=
UPSHIELD_TENANT_ID=
UPSHIELD_SYNC_INTERVAL=60

# === Server ===
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=production

# === Alertas por Correo (SMTP) — Opcional ===
ALERT_EMAILS_ENABLED=False
ALERT_CHECK_INTERVAL=60
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
